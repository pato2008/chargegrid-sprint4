    { "type": "wokwi-pushbutton", "id": "btn1", "top": 200, "left": -180, "attrs": { "color": "green", "label": "Iniciar recarga" } },
    { "type": "wokwi-led", "id": "led_verde", "top": 40, "left": 220, "attrs": { "color": "green" } },
